<!-- OpenMerc MENU-SCRATCH: landing page of the main menu (menu.c sets menu_cancontinue, menu_hassave,
     menu_nosave and om_lastsave_*; "om_continue" returns to the level or loads that save).
     RLabs 2026-11-05: the game's logo (pics/console/logo_sof from the player's own game data) and the single-player
     actions only; the live level shows through (backdrop omflat -> MWD_DrawBackground) -->
<stm>
<strings menu_omset>
<backdrop omflat>

<center>
<blank 1 24><br>
<image "/console/logo_sof" width 384 height 192><br>
<blank 1 12><br>
<font type interface tint normaltext atint hilitetext>
<cinclude menu_cancontinue om_home_cont>
<text "^MENU_OMSET_HOME_NEWGAME^" ombutton btint transgray width 280 height 30 key mouse1 "menu game"><br>
<blank 7 7><br>
<text "^MENU_OMSET_HOME_LOAD^" ombutton btint transgray width 280 height 30 key mouse1 "menu load"><br>
<blank 7 7><br>
<text "^MENU_OMSET_HOME_SETTINGS^" ombutton btint transgray width 280 height 30 key mouse1 "menu video"><br>
<blank 7 7><br>
<text "^MENU_OMSET_HOME_QUIT^" ombutton btint transgray width 280 height 30 key mouse1 "menu quit"><br>
</stm>
