<!-- OpenMerc MENU-SCRATCH: "menu amain" opens this screen (menu.c M_OpenMenu).
     RLabs (play-test 2026-11-05: "main menu looks very complicated, feels not related to the game. Multiplayer needs
     to be hidden"): a plain title screen - the game's own logo and one column of buttons over a live level
     (cl_menuscene.c, menus/om_scene.txt); no rail, tabs or ticker, no multiplayer -->
<stm>
<strings menu_generic>
<strings menu_omset>

<set menu_sk_saving $sk_saving>
<set menu_sk_spawning $sk_spawning>
<set menu_sk_toughness $sk_toughness>
<set menu_sk_maxencum $sk_maxencum>
<set menu_cheats $cheats>

<include om_tints>
<set scr_menuoverlay 1>

<frame home 640 480 page m_omhome>
</stm>
